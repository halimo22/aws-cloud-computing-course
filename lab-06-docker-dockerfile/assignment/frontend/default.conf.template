# nginx site config. The nginx image runs envsubst on /etc/nginx/templates/*.template
# when the container starts, so ${BACKEND_URL} is replaced by the env variable
# and the result is written to /etc/nginx/conf.d/default.conf.
server {
    listen 80;

    # The page itself.
    location / {
        root  /usr/share/nginx/html;
        index index.html;
    }

    # Everything under /api/ is forwarded to the backend container.
    # The browser only ever talks to this server, so the backend needs no published port.
    location /api/ {
        proxy_pass ${BACKEND_URL};
    }
}
